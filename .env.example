# Docker Compose keeps the runtime paths fixed inside the container:
# /data, /app/migrations, /app/seeds and /app/web.
# Override only operational settings here.
RAILKEEPER_IMAGE=ghcr.io/ichwars/railkeeper:latest
RAILKEEPER_COOKIE_SECURE=auto
RAILKEEPER_MAX_IMAGE_MB=10
RAILKEEPER_MAX_ATTACHMENT_MB=25
RAILKEEPER_ALLOWED_ATTACHMENT_EXTENSIONS=.pdf,.txt,.csv,.json,.xml,.zip,.jpg,.jpeg,.png,.webp
RAILKEEPER_UPDATE_CHECK_URL=https://api.github.com/repos/ichwars/RailKeeper/releases/latest
RAILKEEPER_TRUSTED_PROXY_CIDRS=
RAILKEEPER_PRINTERS=
RAILKEEPER_DEFAULT_PRINTER=

# Optional in-app bug reporting. The issue token/repository enable direct submission.
# The optional asset token/repository enable screenshots. The asset repository must be public
# and differ from the issue repository. Keep tokens in protected local configuration only.
RAILKEEPER_GITHUB_ISSUE_TOKEN=
RAILKEEPER_GITHUB_ISSUE_REPOSITORY=
RAILKEEPER_GITHUB_ASSET_TOKEN=
RAILKEEPER_GITHUB_ASSET_REPOSITORY=
RAILKEEPER_BUG_REPORT_CONTACT_AGE_RECIPIENT=
RAILKEEPER_BUG_REPORT_LABELS=bug,source:in-app
