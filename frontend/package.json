{
  "name": "railkeeper-frontend",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "postinstall": "npm ci --prefix ../tools/api-types --ignore-scripts && npm ci --prefix ../tools/frontend-lint --ignore-scripts",
    "generate:api": "node ../tools/api-types/node_modules/openapi-typescript/bin/cli.js ../openapi/railkeeper.yaml -o src/generated/api.d.ts --default-non-nullable false",
    "predev": "npm run generate:api",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "prebuild": "npm run generate:api",
    "build": "tsc -b && vite build",
    "pretypecheck": "npm run generate:api",
    "typecheck": "tsc -b",
    "lint": "node --test ../tools/frontend-lint/lint.test.mjs && node ../tools/frontend-lint/node_modules/eslint/bin/eslint.js --config ../tools/frontend-lint/eslint.config.mjs src --max-warnings 0",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "pretest": "npm run generate:api",
    "test": "vitest",
    "pretest:run": "npm run generate:api",
    "test:run": "vitest run",
    "pretest:coverage": "npm run generate:api",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "lucide-react": "1.68.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  }
}
